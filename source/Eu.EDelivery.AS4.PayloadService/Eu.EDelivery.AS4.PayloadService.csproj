<Project Sdk="Microsoft.NET.Sdk.Web">
    
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    </PropertyGroup>
    
    <ItemGroup>
      <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.23.0" />
      <PackageReference Include="NLog" Version="6.1.3" />
      <PackageReference Include="NLog.Extensions.Logging" Version="6.1.3" />
      <PackageReference Include="NLog.RegEx" Version="6.1.3" />
      <PackageReference Include="NLog.Web.AspNetCore" Version="6.1.3" />
      <PackageReference Include="Swashbuckle.AspNetCore" Version="10.0.1" />
      <PackageReference Include="System.Reactive" Version="6.1.0" />
    </ItemGroup>
    
    <ItemGroup>
      <Content Update="appsettings.payloadservice.json">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
    
</Project>

